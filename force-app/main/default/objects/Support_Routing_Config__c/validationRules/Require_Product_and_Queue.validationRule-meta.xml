<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Product_and_Queue</fullName>
    <active>false</active>
    <errorConditionFormula>OR(
    ISBLANK(Product__c),
    ISBLANK(Support_Queue__c)
)</errorConditionFormula>
    <errorMessage>Product and Support Queue must be selected.</errorMessage>
</ValidationRule>
